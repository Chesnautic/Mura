{
  "name": "mura",
  "version": "1.0.1",
  "description": "A waveform-obsessed music visualizer with 50 waveform types, falling icon drops, and full color control.",
  "author": "Mura",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/slider": "~5.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.7",
    "expo-audio": "~1.0.10",
    "expo-blur": "~15.0.6",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.6",
    "expo-file-system": "~19.0.11",
    "expo-haptics": "~15.0.6",
    "expo-linear-gradient": "~15.0.6",
    "expo-media-library": "~18.1.1",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.7",
    "expo-video": "~3.0.11",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "~0.5.1",
    "reanimated-color-picker": "^5.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.12",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "electron:start": "electron ./electron/main.js",
    "electron:dev": "cross-env MURA_DEV_SERVER_URL=http://localhost:8081 electron ./electron/main.js",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "postinstall": "node node_modules/@shopify/react-native-skia/scripts/setup-canvaskit.js"
  },
  "private": true,
  "optionalDependencies": {
    "ffmpeg-kit-react-native": "^6.0.2"
  }
}
